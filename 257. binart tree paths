/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {

    public List<String> binaryTreePaths(TreeNode root) {

        List<String> arr = new ArrayList<>();
        searchNode(root, "", arr);
        return arr;
    }

    private void searchNode(TreeNode root, String str, List<String> arr){
        
        if(root == null) return;

        str += root.val;

        if(root.left == null && root.right == null){
        
            arr.add(str);
        
        }else{
        
            str += "->";
            if(root.left !=null)
            searchNode(root.left, str, arr);
            
            if(root.right !=null)
            searchNode(root.right, str,arr);
        
        }

    }
       
}
