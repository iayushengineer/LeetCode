CREATE FUNCTION getNthHighestSalary(N INT) RETURNS INT
BEGIN
set n = N-1;
  RETURN (
      # Write your MySQL query statement below.
    #Select distinct salary as getNthHighestSalary from Employee e1 where N-1 = (Select count(distinct(salary))from Employee e2   where e1.salary < e2.salary)

Select (
    Select distinct salary from employee
    order by salary desc 
    limit 1 offset n
) as getNthHighestSalary
  );
END
