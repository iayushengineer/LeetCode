class Solution {
    public int maxProfit(int[] prices) {
        int diff = 0;
        //int max = 1;
        int min = 0;
        int profit = 0;

        for(int i = 1; i<prices.length; i++){
            // if(max < (initial - prices[i])){
            //     max = initial - prices[i];
            // }else{

            // }
            // if(max < prices[i] && ){
            //     max = prices[i];
            // }
            // if(min > prices[i]){
            //     min = prices[i];
            // }

            if(prices[min] < prices[i]){
                diff =  prices[i] - prices[min];
                
            }else{

                min = i;
                
            }

            if(profit < diff ){
                profit = diff;
            }

        }
        return profit;
    }
}
