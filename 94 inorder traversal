/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public List<Integer> inorderTraversal(TreeNode root) {

        List<Integer> array = new ArrayList<>();
        print(root,array);
        return array;
        
    }

    private void print(TreeNode root, List<Integer> array){

        if(root == null) return;

        

        if(root.left != null)         
         print(root.left, array);

         array.add(root.val);

         if(root.right != null){
            print(root.right, array);
        }

    }
}
