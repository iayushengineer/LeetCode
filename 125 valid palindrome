class Solution {
    public boolean isPalindrome(String s) {
        
        // if(s.isBlank()){
        //     return true;
        // }
        s = s.toLowerCase().replaceAll("[^A-Za-z0-9]","");
        boolean check = false;
        
        for(int i =0; i< s.length(); i++){
            
            if(s.charAt(i)!= s.charAt(s.length()-i-1)){
                return false;
            }

        }
        return true;

    }
}
