/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    List<Integer> list = new ArrayList<>();
    public List<Integer> rightSideView(TreeNode root) {

        
         rightNode(root,0); 
        return list;
    }

    private void rightNode(TreeNode root, int a){
            if(root == null) return;

            if(list.size() == a){
                list.add(root.val);
            }

            rightNode(root.right, a+1);
             rightNode(root.left, a+1);
    }

}
