class Solution {
    public int majorityElement(int[] nums) {

        int count = 0;
        int current = nums[0];
        for(int i = 0; i<nums.length; i++){

            if(current == nums[i]){
                count++;
            }else if(count == 0){
                current = nums[i];
            }else{  
                count--;
            }

        }
        return current;
    }
}
