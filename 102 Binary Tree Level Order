/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    List<List<Integer>> ans;
    public List<List<Integer>> levelOrder(TreeNode root) {
       // List<List<Integer>> list=findLevelOrder(root);
       ans = new ArrayList<>();
       levelOrder(root,0);
        return ans;
    }

    private void levelOrder(TreeNode node, int a){

        if(node == null) return;

        if(ans.size() == a){
            ans.add(new ArrayList<>());
        }

        ans.get(a).add(node.val);
        levelOrder(node.left, a+1);
        levelOrder(node.right, a+1);

    }
}
