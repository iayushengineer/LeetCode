class Solution {
    public long zeroFilledSubarray(int[] nums) {
        
        long count = 0;
        for(int i=0; i< nums.length; i++){
            System.out.println(nums[i]);
            long countZero = 0;
            if(nums[i] == 0){
                 while(i<nums.length && nums[i] == 0) {
                
                    countZero++;    
                    i++;
            
            }
            }
           
            count += countZero*(countZero+1)/2;

            // if(nums[i]==0){
            //     count++;
            // }

            // if( i<(nums.length-1) && nums[i+1] == 0 ){
            //     count++;
            // }

        }
    return count;

    }
}
