        //    while(j<=max){
        //     if(!list.contains(j)){
        //         return j;
        //     }
        //     j++;
        //    }
        //      return 0;

        for (int i = 0; i < nums.length; i++) {
            if (nums[i] <= 0 || nums[i] > nums.length) {
                nums[i] = nums.length + 1;
            }
        }

        for (int i = 0; i < nums.length; i++) {
            int n = Math.abs(nums[i]);
            if (n <= nums.length) {
                
                nums[n-1] = -Math.abs(nums[n-1]);

            }
        }
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] > 0 ) {
                return i+1;
            }
        }
        return nums.length+1;

    }
