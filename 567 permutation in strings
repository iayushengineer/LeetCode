class Solution {
    public boolean checkInclusion(String s1, String s2) {
        
        int[] arr = new int[26];
        int[] arr1 = new int[26];
        int length =0;
        int low = 0;

        for(int i = 0; i<s1.length(); i++){
            arr[s1.charAt(i) - 'a']++;
        }

        for(int i=0;i<s2.length();i++){

            arr1[s2.charAt(i) - 'a']++;
            length = i-low+1;

            while(length > s1.length()){
                arr1[s2.charAt(low) - 'a']--;
                low++;
                length = i-low+1;
            }
            //System.out.println(length);
            if(isAnagram(arr,arr1)){
                return true;       
            }

        }
        return false;
    }

    private boolean isAnagram(int[] arr, int[] arr1){
        for(int i=0; i<arr.length; i++){
            if(arr[i] != arr1[i]){
                return false;
            }

        }
        return true;
    }

}
